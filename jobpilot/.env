# ---- Copy this file to ".env" (run.bat / run.sh does it for you) and fill in your values ----

# AI brain (resume reading, job-fit scoring, cover notes). Key from console.anthropic.com
# Without it JobPilot still works with keyword matching.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# ---- Alerts (all optional) ----
# Email: Gmail > turn on 2-step verification > create an "App password"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
# Phone: install the free "ntfy" app, subscribe to a long random topic, put the same name here
NTFY_TOPIC=

# ---- Optional extra job source: Adzuna India (free key at developer.adzuna.com) ----
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ---- Behaviour ----
# true  = JobPilot submits by itself (default for ~90% auto-apply)
# false = waits for your Approve & submit on every job (safer for first test)
AUTO_SUBMIT=true
MIN_MATCH_SCORE=55
DAILY_APPLY_CAP=25
# Run search + apply automatically every N minutes (0 = only when you press the button)
RUN_EVERY_MINUTES=0
# Greenhouse / Lever forms: true = hidden browser
HEADLESS=true
# Indian portals: false = you see the window (recommended, fewer blocks)
PORTAL_HEADLESS=false
# Open the dashboard in your browser automatically
OPEN_BROWSER=true
PORT=8000
